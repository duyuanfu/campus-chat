.demo-page {
  padding: 20rpx;
  min-height: 100vh;
}

.input-card {
  padding: 24rpx;
  border-radius: 14rpx;
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}
.engine-badge {
  font-size: 20rpx;
  background: #F0F9FF;
  color: #0284C7;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1rpx solid #BAE6FD;
}

.plain-textarea {
  width: 100%;
  height: 140rpx;
  background: #F8FAFC;
  border: 1rpx solid #CBD5E1;
  border-radius: 12rpx;
  padding: 14rpx;
  font-size: 26rpx;
  color: #0F172A;
  margin-bottom: 16rpx;
}

.preset-row {
  margin-bottom: 16rpx;
}
.preset-label {
  font-size: 22rpx;
  color: #64748B;
  display: block;
  margin-bottom: 8rpx;
}
.preset-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.preset-tag {
  background: #F1F5F9;
  color: #334155;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}
.preset-tag:active {
  background: #E2E8F0;
  color: #0284C7;
}

.engine-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #F1F5F9;
}
.engine-tip {
  font-size: 22rpx;
  color: #64748B;
}
.engine-btns {
  display: flex;
  gap: 8rpx;
}
.engine-opt {
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
  background: #F1F5F9;
  color: #64748B;
}
.engine-opt.active {
  background: #0284C7;
  color: #FFFFFF;
  font-weight: 500;
}

.run-btn {
  width: 100%;
}

/* 步骤卡片 */
.steps-section {
  margin-top: 20rpx;
}

.step-card {
  padding: 22rpx;
  margin-bottom: 16rpx;
  border-radius: 14rpx;
}
.step-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}
.step-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.sm3-bg { background: #ECFDF5; color: #047857; }
.sm4-bg { background: #FFFBEB; color: #B45309; }
.sm2-bg { background: #EFF6FF; color: #1D4ED8; }
.success-bg { background: #F0FDF4; color: #15803D; }
.danger-bg { background: #FEF2F2; color: #DC2626; }

.step-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #0F172A;
}
.step-desc {
  font-size: 22rpx;
  color: #64748B;
  margin-bottom: 14rpx;
  line-height: 1.4;
}

.code-box {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
}
.code-label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4rpx;
}
.code-label {
  font-size: 20rpx;
  color: #64748B;
}
.copy-btn {
  font-size: 20rpx;
  color: #0284C7;
  text-decoration: underline;
}
.code-text {
  font-size: 20rpx;
  font-family: monospace;
  color: #1E293B;
  word-break: break-all;
  line-height: 1.35;
  display: block;
}

.highlight-box {
  background: #FFFBEB;
  border-color: #FDE68A;
}
.cipher-code {
  color: #B45309;
  font-weight: 500;
}

.decrypt-result-box {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  border-radius: 10rpx;
  padding: 16rpx;
}
.dec-label {
  font-size: 20rpx;
  color: #15803D;
  margin-bottom: 6rpx;
}
.dec-text {
  font-size: 28rpx;
  color: #14532D;
  font-weight: 600;
  line-height: 1.4;
}

.verify-bar {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  border-radius: 10rpx;
}
.success-bar {
  background: #F0FDF4;
  border: 1rpx solid #BBF7D0;
  color: #15803D;
}
.danger-bar {
  background: #FEF2F2;
  border: 1rpx solid #FECACA;
  color: #991B1B;
}
.bar-txt {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.attack-card {
  border-left: 4rpx solid #DC2626;
}
.danger-box {
  background: #FEF2F2;
  border-color: #FECACA;
}
.danger-text {
  color: #B91C1C;
}
.text-danger {
  color: #DC2626;
}
.mt-16 {
  margin-top: 14rpx;
}
