.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #F4F6F8;
}

/* 顶部微小加密指示 */
.chat-top-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 12rpx 0;
  background: #EBF3F8;
}
.hint-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 5rpx;
  background: #0284C7;
}
.hint-text {
  font-size: 22rpx;
  color: #0369A1;
  font-weight: 500;
}

/* 消息滚动区 */
.messages-scroll {
  flex: 1;
  overflow-y: auto;
}
.messages-wrap {
  padding: 24rpx 20rpx;
}

/* 消息行 */
.message-row {
  display: flex;
  margin-bottom: 24rpx;
  align-items: flex-start;
}

.msg-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 14rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.msg-body {
  max-width: 70%;
  display: flex;
  flex-direction: column;
}

.msg-other {
  justify-content: flex-start;
}
.msg-other .msg-body {
  margin-left: 16rpx;
  align-items: flex-start;
}
.msg-other .msg-bubble {
  background: #FFFFFF;
  color: #1E293B;
  border-radius: 6rpx 22rpx 22rpx 22rpx;
  border: 1rpx solid #E2E8F0;
}

.msg-self {
  justify-content: flex-end;
}
.msg-self .msg-body {
  margin-right: 16rpx;
  align-items: flex-end;
}
.msg-self .msg-bubble {
  background: #0284C7;
  color: #FFFFFF;
  border-radius: 22rpx 6rpx 22rpx 22rpx;
}

.msg-bubble {
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-all;
}

.msg-time {
  font-size: 20rpx;
  color: #94A3B8;
  margin-top: 6rpx;
  padding: 0 4rpx;
}

/* 底部输入框 */
.chat-footer {
  background: #FFFFFF;
  border-top: 1rpx solid #E5E7EB;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}
.chat-input {
  flex: 1;
  background: #F8FAFC;
  border: 1rpx solid #D1D5DB;
  border-radius: 12rpx;
  height: 76rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #0F172A;
}
.send-btn {
  background: #E2E8F0;
  color: #94A3B8;
  font-size: 26rpx;
  font-weight: 600;
  height: 76rpx;
  min-width: 130rpx;
  padding: 0 24rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  line-height: 1;
}
.send-btn::after {
  border: none;
}
.send-active {
  background: #0284C7;
  color: #FFFFFF;
}
